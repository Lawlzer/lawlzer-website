{
	"name": "lawlzer-site",
	"version": "0.1.0",
	"private": true,
	"type": "module",
	"scripts": {
		"build": "next build",
		"build:local": "next build",
		"build:run": "run-s build start:port",
		"build:vercel": "prisma generate && cross-env SKIP_ENV_VALIDATION=true next build",
		"check": "run-s check:lint check:types",
		"check:lint": "next lint",
		"check:types": "tsc --noEmit",
		"db:generate": "prisma migrate dev",
		"db:migrate": "prisma migrate deploy",
		"db:push": "prisma db push",
		"db:studio": "prisma studio",
		"debug:reset-data-platform": "tsx scripts/debugResetDataPlatform.ts",
		"dev": "next dev --turbo",
		"lint": "run-s lint:echo lint:all",
		"lint:all": "run-s lint:eslint lint:prettier",
		"lint:echo": "echo Linting all files:",
		"lint:eslint": "eslint --fix --config ./.config/.eslint.config.mjs",
		"lint:eslint:commit": "cross-env LINT_STAGED_COMMIT=true eslint --fix --config ./.config/.eslint.config.mjs",
		"lint:eslint:debug": "cross-env TIMING=1 eslint --config ./.config/.eslint.config.mjs",
		"lint:prettier": "prettier --write --cache --config ./.config/.prettierrc.mjs \"**/*.{ts,tsx,js,jsx,mdx}\"",
		"lint:prettier:commit": "cross-env LINT_STAGED_COMMIT=true prettier --write --cache --config ./.config/.prettierrc.mjs \"**/*.{ts,tsx,js,jsx,mdx}\"",
		"lint:prettier:debug": "prettier --write --config ./.config/.prettierrc.mjs --ignore-path ./.gitignore",
		"lint:staged": "lint-staged",
		"pre-commit": "lint-staged",
		"prepare": "husky",
		"preview": "run-s build start",
		"start": "next start",
		"start:port": "next start -p ${PORT:-3000}",
		"test": "run-s test:unit test:e2e",
		"test:e2e": "cross-env SKIP_ENV_VALIDATION=true playwright test",
		"test:e2e:watch": "nodemon --watch app --watch src --watch tests --ext ts,tsx,js,jsx,mdx --exec \"cross-env SKIP_ENV_VALIDATION=true playwright test\"",
		"test:unit": "cross-env SKIP_ENV_VALIDATION=true vitest run",
		"test:unit:watch": "cross-env SKIP_ENV_VALIDATION=true vitest watch",
		"typecheck": "tsc --noEmit"
	},
	"lint-staged": {
		"*.{ts,tsx,js,jsx,mdx}": [
			"eslint --config ./.config/.eslint.config.mjs --fix",
			"prettier --config ./.config/.prettierrc.mjs --write"
		]
	},
	"prettier": "./.config/.prettierrc.mjs",
	"dependencies": {
		"@headlessui/react": "^2.2.4",
		"@heroicons/react": "^2.2.0",
		"@lawlzer/config": "A:/packages/@lawlzer-config",
		"@lawlzer/utils": "^4.0.2",
		"@prisma/client": "^6.9.0",
		"@t3-oss/env-nextjs": "^0.13.8",
		"@tailwindcss/postcss": "^4.1.10",
		"@tanstack/react-query": "^5.80.7",
		"@trpc/client": "^11.4.1",
		"@trpc/react-query": "^11.4.1",
		"@trpc/server": "^11.4.1",
		"@visx/visx": "3.13.2-alpha.0",
		"clsx": "^2.1.1",
		"cross-env": "^7.0.3",
		"date-fns": "^4.1.0",
		"framer-motion": "^12.18.1",
		"jsonc-parser": "^3.3.1",
		"mongodb": "^6.17.0",
		"next": "^15.3.3",
		"next-themes": "^0.4.6",
		"postcss": "^8.5.6",
		"react": "^19.1.0",
		"react-dom": "^19.1.0",
		"react-zoom-pan-pinch": "^3.7.0",
		"server-only": "^0.0.1",
		"sharp": "^0.34.2",
		"superjson": "^2.2.2",
		"tailwind-merge": "^3.3.1",
		"tailwindcss": "^4.1.10",
		"zod": "^3.25.64"
	},
	"devDependencies": {
		"@eslint/eslintrc": "^3.3.1",
		"@playwright/test": "^1.53.0",
		"@testing-library/dom": "^10.4.0",
		"@testing-library/jest-dom": "^6.6.3",
		"@testing-library/react": "^16.3.0",
		"@types/node": "^24.0.3",
		"@types/react": "^19.1.8",
		"@types/react-dom": "^19.1.6",
		"@vitejs/plugin-react": "^4.5.2",
		"@vitest/coverage-v8": "^3.2.3",
		"dotenv": "^16.5.0",
		"eslint": "^9.29.0",
		"eslint-config-next": "^15.3.3",
		"eslint-config-prettier": "^10.1.5",
		"eslint-plugin-react": "^7.37.5",
		"eslint-plugin-react-hooks": "^5.2.0",
		"husky": "^9.1.7",
		"jsdom": "^26.1.0",
		"lint-staged": "^16.1.2",
		"next-test-api-route-handler": "^5.0.3",
		"nodemon": "^3.1.10",
		"npm-run-all2": "^8.0.4",
		"playwright": "^1.53.0",
		"prettier": "^3.5.3",
		"prettier-plugin-packagejson": "^2.5.15",
		"prettier-plugin-tailwindcss": "^0.6.12",
		"prisma": "^6.9.0",
		"tailwindcss-animate": "^1.0.7",
		"ts-node": "^10.9.2",
		"typescript": "^5.8.3",
		"vite-tsconfig-paths": "^5.1.4",
		"vitest": "^3.2.3"
	},
	"packageManager": "npm@11.4.2"
}
